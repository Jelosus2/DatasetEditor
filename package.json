{
  "name": "dataset-editor",
  "desktopName": "com.jelosus1.dataset-editor.desktop",
  "version": "1.0.1",
  "type": "module",
  "main": "dist_app/main.js",
  "description": "A dataset editor",
  "author": "Jelosus1 <navarrorodriguezjesus6@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "electron": "pnpm build:electron && electron .",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:electron": "tsc -p tsconfig.electron.json && tsc -p tsconfig.preload.json",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "package:win": "vite build && pnpm build:electron && electron-builder build --win --publish never",
    "package:linux": "vite build && pnpm build:electron && electron-builder build --linux --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.13.1",
      "onFail": "warn"
    }
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "fs-extra": "^11.4.0",
    "lodash": "^4.18.1",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.13.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "daisyui": "5.7.42",
    "dtext-parser": "^1.0.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^7.0.2",
    "pinia": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vite-svg-loader": "^5.1.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jelosus2/DatasetEditor.git"
  }
}
